# Windows 笔记本用：复制成 .env 再填写 LLM_API_KEY。.env 不要提交、不要发给别人。
# 路径不要加引号；相对路径以本项目目录为准。

NAMESPACE=tiktok-k8s-lab
LAB_K8S_DIR=C:\Users\Li Zhuoyang\Desktop\tiktok-k8s-lab\k8s
# 你原来 tiktok-k8s-lab 项目生成的专用 kubeconfig（管理员凭据，只给注入和复位用）
ADMIN_KUBECONFIG=C:\Users\Li Zhuoyang\Desktop\tiktok-k8s-lab\.local\kubeconfig
ADMIN_CONTEXT=kind-tiktok-k8s-lab
# 诊断器的只读凭据：由 scripts\make_diag_kubeconfig.py 生成
DIAG_KUBECONFIG=.local\diag.kubeconfig

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=1.20

BUDGET_TOTAL_SECONDS=180
BUDGET_PER_CALL_TIMEOUT=30
BUDGET_MAX_TOOL_CALLS=25
BUDGET_MAX_MODEL_CALLS=12
