# Windows 用（笔记本和台式机）：复制成 .env 再填写 LLM_API_KEY。.env 不要提交、不要发给别人。
# 路径不要加引号；相对路径以本项目目录为准。

NAMESPACE=tiktok-k8s-lab
# 只有本项目旁边有 tiktok-k8s-lab 目录（笔记本）时才用到；台式机没有这个目录，脚本会跳过业务 app，只跑 Online Boutique
LAB_K8S_DIR=C:\Users\Li Zhuoyang\Desktop\tiktok-k8s-lab\k8s
# 管理员 kubeconfig（只给注入和复位用）。留空 = 自动：笔记本用 tiktok-k8s-lab\.local\kubeconfig，台式机用 ~\.kube\config
ADMIN_KUBECONFIG=
# 集群：kind-<集群名>。Run-Laptop.ps1 / Setup-Boutique.ps1 从这里取集群名（也可以用 -Cluster 参数覆盖）
#   台式机：kind-sg-prod-01    笔记本：kind-tiktok-k8s-lab
ADMIN_CONTEXT=kind-sg-prod-01
# kind.exe 的路径。留空 = 自动：笔记本用 tiktok-k8s-lab\.tools\kind.exe，台式机用 PATH 里的 kind
KIND_EXE=
# 诊断器的只读凭据：由 scripts\make_diag_kubeconfig.py 生成
DIAG_KUBECONFIG=.local\diag.kubeconfig

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=1.20

BUDGET_TOTAL_SECONDS=180
BUDGET_PER_CALL_TIMEOUT=30
BUDGET_MAX_TOOL_CALLS=25
BUDGET_MAX_MODEL_CALLS=12
