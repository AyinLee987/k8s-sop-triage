 "how": "人工判：读每次运行的最终回答和它列出的根因，对照题目的 answer（含 also）和 mechanisms 字段。不用关键词自动判分。判分时不看这次运行属于哪个组（把组名遮住、打乱顺序后再判）。",
 "per_cause": {
  "说明": "题目的每一个真实原因（answer 和 answer.also 里的每一项）分别记两个值：位置和机制。",
  "位置": {
   "对": "点名了正确的对象（哪个服务的 Deployment / Service / Pod 网络）。双向调用里只说“A 和 B 之间”而没有指出是哪一端的，记“没定”。",
   "没定": "把正确的对象和其他对象并列为候选，没有表态。",
   "错": "没有提到，或者明确排除了它。"
  },
  "机制": {
   "大类": "网络（net_delay、net_loss）、CPU 限流（cpu）、配置（config）、应用自身被配置了延迟（app_delay）。只要求大类对；网络里是延迟还是丢包单独记，不影响通过。",
   "对": "把正确的大类作为结论，没有把另一个大类留作同等可能。",
   "倾向对": "把正确的大类写成首要或最可能的原因，同时把另一个大类列为不能排除的备选。",
   "没定": "并列两个大类且不表态，或明确说无法区分。",
   "错": "把错误的大类作为结论，或没有给出机制。",
   "位置错时": "该原因的机制不判，记“-”。"
  }
 },
 "per_run": {
  "多报": "把干扰项（decoys）或不存在的问题当成症状的确定原因，记数。干扰项被列出但明确说不是症状原因的，不算多报。低把握的“不能排除”不算多报。",
  "通过": "每个真实原因都是 位置=对 且 机制∈{对, 倾向对}，并且多报=0。",
  "严格通过": "每个真实原因都是 位置=对 且 机制=对，并且多报=0。",
  "部分": "不通过，但至少有一个真实原因的位置=对。",
  "错": "没有任何一个真实原因的位置=对。"
 },
 "report": {
  "固定三个数": "平均通过率（通过的运行数 / 总运行数）；几遍全通过的题数；每通过一次的 token 用量（该组总 token / 通过次数）。",
  "同时给出": "严格通过率；位置正确率和机制正确率分开报（按“真实原因”为单位：位置=对 的占比；在位置=对 的原因里，机制∈{对,倾向对} 的占比和机制=对 的占比）；按机制大类分开的通过率（网络 / CPU / 配置 / 混合）。",
  "分辨率": "每组每道题 3 遍。12 道题 36 次运行时，两组平均通过率相差不到 20 个百分点一律写“分不清”。"
 },
